# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/pathology_lab
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pathology_lab?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pathology_lab

# Authentication Secret
JWT_SECRET=pathology-lab-secret-jwt-key-2026-production-salt

# Lab Details (Displayed on A4 Test Reports, Receipts, and Dashboard)
NEXT_PUBLIC_LAB_NAME="Apex Diagnostics & Pathology Laboratory"
NEXT_PUBLIC_LAB_TAGLINE="Precision Diagnostics & Advanced Blood Testing"
NEXT_PUBLIC_LAB_ADDRESS="Plot 42, Health City Enclave, Ring Road, New Delhi 110029"
NEXT_PUBLIC_LAB_PHONE="+91 98765 43210 / +91 11 2345 6789"
NEXT_PUBLIC_LAB_EMAIL="reports@apexpathology.lab"
NEXT_PUBLIC_LAB_LICENSE="DL-REG-2024-88492"

# Lab Timezone (Default for daily numbering and reports)
TZ=Asia/Kolkata
